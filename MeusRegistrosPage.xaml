<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.MeusRegistrosPage"
             Title="Meus registros">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Histórico de ponto" Style="{StaticResource Headline}" />
            <Label x:Name="LabelContexto" Style="{StaticResource SubHeadline}" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            x:Name="ListaRegistros"
            EmptyView="Nenhum registro ainda.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="14,12"
                        Margin="0,0,0,10"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="{Binding Tipo}"
                                FontSize="18"
                                FontAttributes="Bold" />
                            <Label
                                Text="{Binding DataHora}"
                                FontSize="15" />
                            <Label
                                Text="{Binding Localizacao}"
                                FontSize="13"
                                TextColor="{AppThemeBinding Light=#666, Dark=#AAA}"
                                IsVisible="{Binding TemLocalizacao}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
