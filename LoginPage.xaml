<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.LoginPage"
             Title="Entrar"
             BackgroundColor="White">

    <Grid RowDefinitions="120,*">
        <Grid BackgroundColor="#2F4DA3">
            <Label 
                Text="Registro de Ponto"
                TextColor="White"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Grid>
        <Grid Grid.Row="1">
            <Frame
                CornerRadius="25"
                Padding="25"
                BackgroundColor="White"
                HasShadow="True"
                >
                <VerticalStackLayout Spacing="18">
                    <Label 
                        Text="Entrar"
                        FontSize="26"
                        TextColor="#1E1E1E"
                        HorizontalOptions="Center"/>
                    
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nome" FontSize="14"/>
                        <Entry x:Name="NomeEntry"
                               Placeholder="Digite seu nome"
                               BackgroundColor="#F5F7FA"
                               TextColor="Black"
                               HeightRequest="45"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Spacing="5">
                        <Label Text="PIN" FontSize="14"/>
                        <Entry x:Name="PinEntry"
                               Placeholder="••••"
                               IsPassword="True"
                               Keyboard="Numeric"
                               BackgroundColor="#F5F7FA"
                               TextColor="Black"
                               HeightRequest="45"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Spacing="10">

                        <Button 
                            Text="Entrar"
                            BackgroundColor="#2F4DA3"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="50"
                            Clicked="OnEntrarClicked"/>

                        <Button 
                            Text="Cadastrar"
                            BackgroundColor="Transparent"
                            TextColor="#2F4DA3"
                            BorderColor="#2F4DA3"
                            BorderWidth="2"
                            CornerRadius="12"
                            HeightRequest="50"
                            Clicked="OnCadastrarClicked"/>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

        </Grid>

    </Grid>

</ContentPage>