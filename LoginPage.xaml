<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.LoginPage"
             Title="Entrar">

    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Entrar" Style="{StaticResource Headline}" />
        <Label Text="Nome" />
        <Entry x:Name="NomeEntry" Placeholder="Nome" />
        <Label Text="PIN" />
        <Entry x:Name="PinEntry" Placeholder="PIN" IsPassword="True" Keyboard="Numeric" />

        <HorizontalStackLayout Spacing="12">
            <Button Text="Entrar" Clicked="OnEntrarClicked" />
            <Button Text="Cadastrar" Clicked="OnCadastrarClicked" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>