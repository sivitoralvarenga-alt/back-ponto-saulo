<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.UsuariosPage"
             Title="Usuários">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="12">
        <Label
            Grid.Row="0"
            Text="Usuários"
            Style="{StaticResource Headline}" />
        <Label
            Grid.Row="1"
            x:Name="LabelDica"
            Text="Selecione quem está registrando o ponto. Cadastre novos usuários pelo botão abaixo."
            Style="{StaticResource SubHeadline}" />

        <Grid Grid.Row="2" RowDefinitions="*,Auto" RowSpacing="12">
            <CollectionView
                x:Name="ListaUsuarios"
                SelectionMode="Single"
                SelectionChanged="OnUsuarioSelecionado">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="12,8" Spacing="4">
                            <Label Text="{Binding Nome}" FontSize="18" />
                            <Label Text="{Binding Email}" FontSize="14" TextColor="{AppThemeBinding Light=#666, Dark=#AAA}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button
                Grid.Row="1"
                Text="Novo usuário"
                Clicked="OnNovoUsuarioClicked" />
        </Grid>
    </Grid>
</ContentPage>
