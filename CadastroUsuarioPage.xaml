<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.CadastroUsuarioPage"
             Title="Cadastrar"
             BackgroundColor="White">

    <Grid RowDefinitions="120,*,120">

        <Grid Grid.Row="0" BackgroundColor="#2F4DA3">
            <Label 
                Text="Cadastro"
                TextColor="White"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Grid>

        <Grid Grid.Row="1">

            <Frame
                CornerRadius="25"
                Padding="25"
                BackgroundColor="White"
                HasShadow="True"
                >

                <ScrollView>
                    <VerticalStackLayout Spacing="18">

                        <Label 
                            Text="Criar Conta"
                            FontSize="26"
                            TextColor="#1E1E1E"
                            HorizontalOptions="Center"/>

                        <Grid HorizontalOptions="Center">

                            <Frame CornerRadius="60"
                                   HeightRequest="120"
                                   WidthRequest="120"
                                   BackgroundColor="#F5F5F5"
                                   Padding="0"
                                   HasShadow="False"
                                   InputTransparent="True">

                                <Image x:Name="FotoPreview"
                                       Aspect="AspectFill"
                                       IsVisible="False"/>
                            </Frame>

                            <ImageButton x:Name="IconeCamera"
                                         Source="camera.png"
                                         BackgroundColor="White"
                                         HeightRequest="40"
                                         WidthRequest="40"
                                         CornerRadius="20"
                                         Clicked="TirarFoto"/>
                        </Grid>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Nome"/>
                            <Entry x:Name="NomeEntry" Placeholder="Digite seu nome"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Email"/>
                            <Entry x:Name="EmailEntry" Placeholder="Digite seu email" Keyboard="Email"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="PIN"/>
                            <Entry x:Name="PinEntry"
                                   Placeholder="Crie um PIN"
                                   IsPassword="True"
                                   Keyboard="Numeric"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Confirmar PIN"/>
                            <Entry x:Name="ConfirmarPinEntry"
                                   Placeholder="Repita o PIN"
                                   IsPassword="True"
                                   Keyboard="Numeric"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">

                            <Button 
                                Text="Cadastrar"
                                BackgroundColor="#2F4DA3"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="50"
                                Clicked="OnSalvarClicked"/>

                            <Button 
                                Text="Voltar"
                                BackgroundColor="Transparent"
                                TextColor="#2F4DA3"
                                BorderColor="#2F4DA3"
                                BorderWidth="2"
                                CornerRadius="12"
                                HeightRequest="50"
                                Clicked="OnVoltarClicked"/>

                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

            </Frame>

        </Grid>

        <BoxView Grid.Row="2" BackgroundColor="#2F4DA3"/>

    </Grid>

</ContentPage>